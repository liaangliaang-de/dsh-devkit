{
  "name": "dsh-devkit",
  "version": "0.2.6",
  "description": "Single-entry wish coding: repository context, safe span edits, milestones and native browser verification",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "exports": {
    ".": "./lib/plugin.js",
    "./core": "./lib/core.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "prepack": "npm run build",
    "test:native": "node scripts/native-test.mjs"
  },
  "dependencies": {
    "playwright-core": "1.62.1",
    "typescript": "6.0.3"
  },
  "bundleDependencies": [
    "playwright-core",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liaangliaang-de/dsh-devkit.git"
  },
  "homepage": "https://github.com/liaangliaang-de/dsh-devkit#readme",
  "bugs": {
    "url": "https://github.com/liaangliaang-de/dsh-devkit/issues"
  },
  "keywords": [
    "deepseek",
    "harness",
    "coding-agent",
    "plugin",
    "developer-tools"
  ]
}
